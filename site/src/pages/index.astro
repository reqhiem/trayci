---
import "@fontsource-variable/space-grotesk";
import "../styles/site.css";
import { readFileSync } from "node:fs";
import Antigravity from "../icons/antigravity.svg";
import Claude from "../icons/claude.svg";
import Codex from "../icons/codex.svg";
import GitHub from "../icons/github.svg";
import Linux from "../icons/linux.svg";
import Windows from "../icons/windows.svg";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(base, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
const repo = "https://github.com/reqhiem/trayci";
const latest = `${repo}/releases/latest`;
const script = (name: string) => new URL(`${base}${name}`, Astro.site).href;

const title = "Trayci: Claude Code, Codex, and Antigravity usage in your tray";
const description =
  "Trayci is a local-first tray app for Linux and Windows that shows your Claude Code, Codex, and Antigravity quota windows and when they reset. It reuses each CLI's sign-in and never stores credentials.";

// Resolved at build time. Offline, rate-limited, or an odd payload: every link keeps the releases page.
const links = { appimage: latest, deb: latest, exe: latest, notes: latest };
let version = "";
try {
  const headers: Record<string, string> = {
    Accept: "application/vnd.github+json",
    "User-Agent": "trayci-site",
  };
  if (process.env.GITHUB_TOKEN)
    headers.Authorization = `Bearer ${process.env.GITHUB_TOKEN}`;
  const response = await fetch(
    "https://api.github.com/repos/reqhiem/trayci/releases/latest",
    { headers, signal: AbortSignal.timeout(10_000) },
  );
  if (!response.ok) throw new Error(`GitHub API answered ${response.status}`);
  const release = await response.json();
  const asset = (suffix: string): string =>
    release.assets.find((a: { name: string }) => a.name.endsWith(suffix))
      ?.browser_download_url ?? latest;
  links.appimage = asset("_amd64.AppImage");
  links.deb = asset("_amd64.deb");
  links.exe = asset("_x64-setup.exe");
  links.notes = release.html_url ?? latest;
  version = String(release.tag_name ?? "");
} catch (error) {
  console.warn(`Release lookup failed, linking to ${latest}:`, error);
}
const versionLabel = version
  ? `Version ${version.replace(/^v/, "")}`
  : "The latest release";

// Screens are @2x captures, so half the PNG's pixel size is the popover's real size.
const screen = (name: string, alt: string) => {
  const png = readFileSync(`public/screens/${name}.png`);
  return {
    src: `${base}screens/${name}.png`,
    width: Math.round(png.readUInt32BE(16) / 2),
    height: Math.round(png.readUInt32BE(20) / 2),
    alt,
  };
};
const countdowns = screen(
  "usage-detail-dark",
  "Detail pane listing each usage window with a bar, the percentage used, and a reset countdown",
);

// The notification switches from the app's settings, each drawn at the level where it fires.
const alerts = [
  { label: "Quota reaches 50%", used: 50, level: "medium" },
  { label: "Quota reaches 85%", used: 85, level: "high" },
  { label: "Quota reaches 90%", used: 90, level: "critical" },
  { label: "Quota reset completes", used: 0, level: "low" },
];

const clips = {
  hero: "Trayci's popover showing Antigravity, Claude Code, and Codex usage with reset countdowns",
  detail:
    "Hovering a provider opens its windows in a side pane, and clicking pins the pane open",
  themes:
    "Trayci switching from the dark to the light theme and back, then from used to remaining percentages",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0f14" />
    <link rel="icon" href={`${base}brand/trayci.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}brand/apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trayci" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Trayci's tray popover with Claude Code, Codex, and Antigravity usage"
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="wrap nav">
      <a class="brand" href={base}>
        <img src={`${base}brand/trayci.svg`} width="28" height="28" alt="" />
        Trayci
      </a>
      <nav aria-label="Primary">
        <ul>
          <li><a href="#features">Features</a></li>
          <li><a href="#install">Install</a></li>
          <li>
            <a href={repo}><GitHub class="icon" aria-hidden="true" />GitHub</a>
          </li>
        </ul>
      </nav>
    </header>

    <main>
      <section class="wrap hero">
        <h1>
          <span>
            <span class="brandname"
              ><Claude class="logo" aria-hidden="true" />Claude Code,</span
            >
            <span class="brandname"
              ><Codex class="logo" aria-hidden="true" />Codex,</span
            >
          </span>
          <span>
            and <span class="brandname"
              ><Antigravity class="logo" aria-hidden="true" />Antigravity</span
            >
            usage,
          </span>
          <span>one click away.</span>
        </h1>
        <video
          class="frame"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={`${base}media/hero.jpg`}
          width="1600"
          height="1000"
          aria-label={clips.hero}
        >
          <source
            src={`${base}media/hero.mp4`}
            type="video/mp4"
            media="(prefers-reduced-motion: no-preference)"
          />
        </video>
        <p class="lead">
          Every quota and every reset, right in your tray on Linux and Windows.
          No new account, no stored credentials.
        </p>
        <div class="actions">
          <div class="combo">
            <a class="button primary" href={links.appimage}>
              Download for Linux <small>AppImage, amd64</small>
            </a>
            <details class="downloads">
              <summary class="button primary" aria-label="More Linux downloads">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
              </summary>
              <ul>
                <li>
                  <a href={links.appimage}>AppImage <small>Most distributions</small></a>
                </li>
                <li>
                  <a href={links.deb}>.deb <small>Debian and Ubuntu</small></a>
                </li>
              </ul>
            </details>
          </div>
          <a class="button primary" href={links.exe}>
            Download for Windows <small>Installer, x64</small>
          </a>
          <a class="button ghost" href={repo}>
            <GitHub class="icon" aria-hidden="true" />View on GitHub
          </a>
          {
            version && (
              <a
                class="tag"
                href={links.notes}
                aria-label={`${version} release notes`}
              >
                {version}
              </a>
            )
          }
        </div>
      </section>

      <section id="features" class="section">
        <div class="wrap">
          <h2>Every limit at a glance</h2>
          <p class="intro">
            Fresh numbers on your schedule, and again the moment your computer
            wakes.
          </p>
          <div class="features">
            <div class="feature">
              <h3>Detailed or compact</h3>
              <p>See every limit in full, or only the one that matters.</p>
              <video
                class="frame media"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={`${base}media/detail.jpg`}
                width="1200"
                height="900"
                aria-label={clips.detail}
              >
                <source
                  src={`${base}media/detail.mp4`}
                  type="video/mp4"
                  media="(prefers-reduced-motion: no-preference)"
                />
              </video>
            </div>
            <div class="feature">
              <h3>Know when it resets</h3>
              <p>A countdown on every limit, so you know when you're back.</p>
              <div class="frame media stage">
                <img
                  src={countdowns.src}
                  width={countdowns.width}
                  height={countdowns.height}
                  alt={countdowns.alt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="feature">
              <h3>Notifications you choose</h3>
              <p>A heads-up before you run out, and another when you're back.</p>
              <div class="frame media stage">
                <div
                  class="alerts"
                  role="img"
                  aria-label="Usage bars at 50%, 85%, and 90% in yellow, orange, and red, and an empty bar after a reset"
                >
                  {
                    alerts.map((alert) => (
                      <div class="alert">
                        <span>{alert.label}</span>
                        <span class={`bar ${alert.level}`}>
                          <span style={`width: ${alert.used}%`} />
                        </span>
                        <strong>{alert.used}%</strong>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
            <div class="feature">
              <h3>Light, dark, or Auto</h3>
              <p>Matches your desktop, at the text size you read best.</p>
              <video
                class="frame media"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={`${base}media/themes.jpg`}
                width="1200"
                height="900"
                aria-label={clips.themes}
              >
                <source
                  src={`${base}media/themes.mp4`}
                  type="video/mp4"
                  media="(prefers-reduced-motion: no-preference)"
                />
              </video>
            </div>
          </div>
          <div class="notes">
            <div>
              <h3>Local-first, credential-free</h3>
              <p>
                Uses the sign-in your CLIs already have.
                <a href="#privacy">How it handles your sign-ins</a>
              </p>
            </div>
            <div>
              <h3>Drag it anywhere</h3>
              <p>Move the popover wherever it suits you.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="privacy" class="section">
        <div class="wrap split">
          <h2>Nothing new to sign in to</h2>
          <div class="facts">
            <div>
              <h3>Reuses the sign-in you have</h3>
              <p>
                Trayci fetches your usage with the sign-in Claude Code, Codex,
                and Antigravity already have. There's no account to create.
              </p>
            </div>
            <div>
              <h3>Never stores credentials</h3>
              <p>Your sign-ins are read, never copied or saved. Each CLI keeps its own.</p>
            </div>
            <div>
              <h3>Stays on your computer</h3>
              <p>
                Your settings and usage cache live on your machine. There's no
                Trayci server.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="compatibility" class="section">
        <div class="wrap">
          <h2>Where it runs</h2>
          <ul class="platforms">
            <li>
              <span class="marks"><Linux aria-hidden="true" /></span>
              <h3>Linux</h3>
              <p>Ubuntu, Linux Mint, and more, on 64&#8209;bit Intel and AMD PCs.</p>
            </li>
            <li>
              <span class="marks"><Windows aria-hidden="true" /></span>
              <h3>Windows</h3>
              <p>Installs in a few clicks on 64&#8209;bit Windows.</p>
            </li>
            <li>
              <span class="marks">
                <Claude aria-hidden="true" />
                <Codex aria-hidden="true" />
                <Antigravity aria-hidden="true" />
              </span>
              <h3>Works with your CLIs</h3>
              <p>
                Install and sign in to Claude Code, Codex, or Antigravity's agy.
                Any one is enough.
              </p>
            </li>
          </ul>
          <p class="more">
            <a href={`${repo}/blob/main/COMPATIBILITY.md`}>Full compatibility notes</a>
          </p>
        </div>
      </section>

      <section id="install" class="section">
        <div class="wrap">
          <h2>Install Trayci</h2>
          <p class="intro">
            {versionLabel}, from <a href={`${repo}/releases`}>GitHub Releases</a>.
          </p>
          <div class="installs">
            <div class="install">
              <h3>Terminal <small>Linux and Windows</small></h3>
              <div class="commands">
                <span>Linux</span>
                <pre><code>curl -fsSL {script("install.sh")} | sh</code></pre>
                <span>Windows PowerShell</span>
                <pre><code>irm {script("install.ps1")} | iex</code></pre>
              </div>
              <a class="button ghost" href={`${repo}/tree/main/site/public`}>Read the scripts</a>
            </div>
            <div class="install">
              <h3>AppImage <small>Linux amd64</small></h3>
              <pre><code>chmod +x Trayci_*_amd64.AppImage && ./Trayci_*_amd64.AppImage</code></pre>
              <a class="button ghost" href={links.appimage}>Download AppImage</a>
            </div>
            <div class="install">
              <h3>Debian and Ubuntu <small>Linux amd64</small></h3>
              <pre><code>sudo apt install ./Trayci_*_amd64.deb</code></pre>
              <a class="button ghost" href={links.deb}>Download .deb</a>
            </div>
            <div class="install">
              <h3>Windows <small>x64</small></h3>
              <p>Run <code>Trayci_*_x64-setup.exe</code>.</p>
              <a class="button ghost" href={links.exe}>Download installer</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="wrap footer">
      <a class="brand" href={base}>
        <img src={`${base}brand/trayci.svg`} width="24" height="24" alt="" />
        Trayci
      </a>
      <ul>
        <li><a href={repo}>GitHub</a></li>
        <li><a href={`${repo}/releases`}>Releases</a></li>
        <li><a href={`${repo}/blob/main/LICENSE`}>MIT License</a></li>
      </ul>
      <a class="author" href="https://reqhiem.dev">
        <img
          src="https://avatars.githubusercontent.com/reqhiem?s=80"
          width="40"
          height="40"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span>Developed by <strong>reqhiem</strong></span>
      </a>
      <p>Not affiliated with Anthropic, OpenAI, or Google.</p>
    </footer>

    <script>
      // <details> has no light dismiss: close the Linux menu on Escape or a click outside it.
      const menu = document.querySelector<HTMLDetailsElement>(".downloads");
      if (menu) {
        document.addEventListener("click", (event) => {
          if (!menu.contains(event.target as Node)) menu.open = false;
        });
        menu.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || !menu.open) return;
          menu.open = false;
          menu.querySelector("summary")?.focus();
        });
      }
    </script>
  </body>
</html>
