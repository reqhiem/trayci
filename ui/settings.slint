// Placeholder for the settings view (W2): proves the contract, not the design. Named
// SettingsPage because `SettingsView` is the struct it edits.
import { CheckBox, Button } from "std-widgets.slint";
import { Bridge, SettingsView } from "bridge.slint";
import { Theme } from "theme.slint";

component Label inherits Text {
    color: Theme.paper;
    vertical-alignment: center;
}

export component SettingsPage inherits Rectangle {
    // A copy to edit: Bridge.settings is Rust's, and update-settings takes the whole struct.
    property <SettingsView> draft;

    VerticalLayout {
        width: 360px * Theme.scale;
        alignment: start;
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            height: 32px * Theme.scale;
            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        Bridge.begin-drag();
                    }
                }
                Label {
                    x: 0;
                    text: "Settings";
                    font-weight: 600;
                }
            }
            TouchArea {
                width: 24px * Theme.scale;
                clicked => { Bridge.settings-open = false; }
                Label { text: "←"; }
            }
        }
        CheckBox {
            text: "Start on login";
            checked: Bridge.settings.start-on-login;
            toggled => {
                root.draft = Bridge.settings;
                root.draft.start-on-login = self.checked;
                Bridge.update-settings(root.draft);
            }
        }
        CheckBox {
            text: "Compact view";
            checked: Bridge.settings.compact;
            toggled => {
                root.draft = Bridge.settings;
                root.draft.compact = self.checked;
                Bridge.update-settings(root.draft);
            }
        }
        CheckBox {
            text: "Show remaining";
            checked: Bridge.settings.show-remaining;
            toggled => {
                root.draft = Bridge.settings;
                root.draft.show-remaining = self.checked;
                Bridge.update-settings(root.draft);
            }
        }
        Button {
            text: "Theme: " + Bridge.settings.theme;
            clicked => {
                root.draft = Bridge.settings;
                root.draft.theme = Bridge.settings.theme == "dark" ? "light"
                    : Bridge.settings.theme == "light" ? "system" : "dark";
                Bridge.update-settings(root.draft);
            }
        }
        Button {
            text: "Text size: " + Bridge.settings.font-scale;
            clicked => {
                root.draft = Bridge.settings;
                root.draft.font-scale = Bridge.settings.font-scale >= 1.3 ? 0.9
                    : Bridge.settings.font-scale >= 1.15 ? 1.3
                    : Bridge.settings.font-scale >= 1 ? 1.15 : 1;
                Bridge.update-settings(root.draft);
            }
        }
        for provider in Bridge.settings.providers : Label {
            text: provider.label + (provider.enabled ? " on" : " off");
        }
        HorizontalLayout {
            spacing: 6px;
            Label {
                text: Bridge.settings.has-position
                    ? "Position \{Bridge.settings.position-x}, \{Bridge.settings.position-y}"
                    : "Position: at the tray";
            }
            Button {
                text: "Reset";
                enabled: Bridge.settings.positions-real && Bridge.settings.has-position;
                clicked => { Bridge.reset-position(); }
            }
        }
        Button {
            text: "Quit Trayci";
            clicked => { Bridge.quit(); }
        }
    }
}
