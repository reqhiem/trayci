{
  "name": "trayci",
  "version": "0.1.0",
  "description": "AI coding quota usage in your Linux system tray",
  "author": {
    "name": "Joel Perca",
    "email": "joelperca.vc@gmail.com"
  },
  "homepage": "https://github.com/reqhiem/trayci",
  "desktopName": "com.trayci.Trayci",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "electron-builder install-app-deps",
    "build": "pnpm typecheck && electron-vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "node-pty": "^1.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.trayci.Trayci",
    "productName": "Trayci",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "linux": {
      "executableName": "trayci",
      "category": "Utility",
      "maintainer": "Joel Perca <joelperca.vc@gmail.com>",
      "synopsis": "AI coding quota usage in your system tray",
      "syncDesktopName": true,
      "icon": "resources/icons",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "appImage": {
      "artifactName": "Trayci-${version}.${ext}"
    },
    "deb": {
      "artifactName": "trayci_${version}_amd64.${ext}"
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
